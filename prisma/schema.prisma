// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  READER
}

enum Locale {
  pt
  en
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(READER)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]
  likes    Like[]
  avatar   Avatar?
}

// Foto de perfil fora da tabela User para não carregar bytes em toda consulta de usuário.
// ponytail: guardado no Postgres (256px WebP, ~20KB); mover para object storage se os acessos crescerem
model Avatar {
  userId    String   @id
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tabelas padrão do Auth.js
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Post {
  id          String    @id @default(cuid())
  coverImage  String?
  publishedAt DateTime? // null = rascunho
  newsletterSentAt DateTime? // evita disparar a mesma edição duas vezes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  translations PostTranslation[]
  tags         Tag[]
  comments     Comment[]
  likes        Like[]

  @@index([publishedAt])
}

model PostTranslation {
  id      String @id @default(cuid())
  postId  String
  locale  Locale
  slug    String
  title   String
  excerpt String
  content String // Markdown
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  namePt String
  nameEn String
  posts  Post[]
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime? // removido com respostas: mantém a linha para não apagar respostas de outros
  postId    String
  userId    String
  parentId  String?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")

  @@index([postId, createdAt])
}

model Like {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// Newsletter com double opt-in: só recebe quem confirmou pelo link do e-mail
model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  locale      Locale    @default(pt)
  token       String    @unique @default(cuid()) // confirmar e descadastrar
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Imagens enviadas pelo admin (capas). Servidas em /media/[id].
// ponytail: bytes no Postgres (capas ~150KB WebP); migrar para object storage se o volume crescer
model Media {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String
  createdAt DateTime @default(now())
}
